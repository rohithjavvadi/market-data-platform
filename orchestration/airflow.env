export AIRFLOW_HOME="$HOME/airflow"
export AIRFLOW__CORE__DAGS_FOLDER="$HOME/market-data-platform/orchestration/dags"
export AIRFLOW__CORE__LOAD_EXAMPLES=False
export AIRFLOW__API__PORT=8081
export MDP_PY=/opt/anaconda3/bin/python
export MDP_DBT=/opt/anaconda3/bin/dbt
export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES
export no_proxy="*"
export AIRFLOW__API__BASE_URL=http://localhost:8081
export AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://localhost:8081/execution/
